# Configuration Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi

# 🚀 Modèles légers (rapides, <5min par génération)
# OLLAMA_MODEL=phi              # ⭐ Très rapide (2B), idéal pour CPU
# OLLAMA_MODEL=neural-chat      # Rapide (7B), bon pour CPU
# OLLAMA_MODEL=mistral          # Bon compromis (7B), qualité+vitesse
# OLLAMA_MODEL=orca-mini        # Léger (7B), spécialisé instructions

# 🔥 Modèles moyens (lents sur CPU, rapides sur GPU)
# OLLAMA_MODEL=qwen:7b          # Petit Qwen (7B)
# OLLAMA_MODEL=qwen2.5          # Qwen rapide (8B)
# OLLAMA_MODEL=qwen3            # Qwen standard (14B) - lent sur CPU

# 💪 Modèles lourds (très lent sur CPU)
# OLLAMA_MODEL=qwen:32b         # Qwen large (32B)
# OLLAMA_MODEL=deepseek-coder   # Pour code (6.7B, bon compromis)

