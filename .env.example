# Configuration Ollama (voir MODELS.md pour choisir un modèle adapté à ta machine)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# Le modèle doit gérer les "tools" pour la recherche approfondie de l'Assistant
# OLLAMA_MODEL=qwen3:4b         # Machine sans GPU
# OLLAMA_MODEL=qwen2.5          # Plus rapide (pas de phase de réflexion)
# OLLAMA_MODEL=llama3.1         # Alternative
# OLLAMA_MODEL=phi              # ⚠️ Sans outils : recherche rapide uniquement

# Temps max (secondes) laissé au modèle pour générer une page
OLLAMA_TIMEOUT=600

# Niveau de logs : DEBUG pour voir les prompts et réponses brutes
LOG_LEVEL=INFO

# Dossier des données (base SQLite + pages Markdown)
# DATA_DIR=./data

# Synthèse vocale locale (Piper) : nom de voix (dans ./voices) ou chemin vers un .onnx
# Téléchargement : python -m piper.download_voices fr_FR-siwis-medium --download-dir voices
# Autres voix FR : fr_FR-upmc-medium, fr_FR-tom-medium, fr_FR-gilles-low…
PIPER_VOICE=fr_FR-siwis-medium

# Transcription locale (faster-whisper) : tiny / base / small / medium / large-v3 / turbo
WHISPER_MODEL=small
WHISPER_DEVICE=auto      # cpu / cuda
WHISPER_COMPUTE=int8     # float16 sur GPU
